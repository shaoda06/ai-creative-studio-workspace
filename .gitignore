# 默认允许Git发现新增文件，仅排除以下本机内容。

# 本机Codex配置。
/.codex/
/comfyui-config.json
/提示词管理/
/提示词库/隐私/

# 已独立安装、由上游按需获取的技能，不随本模板重复分发。
/.agents/skills/h3-prompt-writing/
/.agents/skills/qwen-image-2-1-prompter/
/.agents/skills/screenwriting-master/
/.agents/skills/stop-that-shit/
/.agents/skills/stss/
/.agents/skills/find-skills/
/.agents/skills/vercel-react-best-practices/
/.agents/skills/fastapi/
/.agents/skills/humanizer-zh/
/.agents/skills/dialogue/
/.agents/skills/herk-edit-kit/
/.agents/skills/video-use/
/.agents/skills/ghost-editor/
/.agents/skills/video-talkcraft/

# 真实项目和本机过程资料不公开，保留目录用途说明。
/projects/*
!/projects/README.md
/综合资料/*
!/综合资料/README.md

# 技能历史、真实服务库存及本机缓存。
**/历史版本/
**/state/
**/__pycache__/
**/.DS_Store
*.py[cod]
.env
.env.*

# Krea2现行资源入库，下载暂存和上一版备份不入库。
/工作区浏览服务/Krea2风格库/Krea2_更新工具/work/
/工作区浏览服务/.venv/
/工作区浏览服务/frontend/node_modules/
/工作区浏览服务/frontend/dist/
/工作区浏览服务/frontend/*.tsbuildinfo
/工作区浏览服务/runtime/

# 公开提示词允许使用与其他目录同名的分类；隐私、回收站和临时写入不入库。
!/提示词库/公开/**/
!/提示词库/公开/**/*.md
/提示词库/公开/.trash/
/提示词库/公开/**/.prompt-*.tmp

# One total workspace; real data, nested Iris repository and legacy path alias stay local.
/projects
/workspaces/Iris Workspace/
/workspaces/Nora Workspace/projects/*
!/workspaces/Nora Workspace/projects/README.md
/workspaces/Nora Workspace/综合资料/*
/workspaces/Nora Workspace/comfyui-config.json
/workspaces/Nora Workspace/工作区浏览服务/

# Chloe skills and skeleton are public; account data, assets and actual videos stay local.
/workspaces/Chloe Workspace/projects/*
!/workspaces/Chloe Workspace/projects/README.md
/workspaces/Chloe Workspace/综合资料/*
/workspaces/Chloe Workspace/comfyui-config.json
